# Reown AppKit project ID (free): https://dashboard.reown.com. Allowlist localhost and your deploy domain.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Socemon v2 on Monad testnet
NEXT_PUBLIC_SOCEMON_ADDRESS=
# Relayer key. It only holds MINTER_ROLE on the contract; keep it funded with testnet MON.
MINTER_PRIVATE_KEY=
# Optional private RPCs for when the public one rate-limits (server, browser)
MONAD_RPC_URL=
NEXT_PUBLIC_MONAD_RPC_URL=

# Secrets: openssl rand -hex 32
SESSION_SECRET=
CHECKIN_SECRET=
WALL_KEY=

# The event itself (name, times, drop) lives in Firestore document config/event: run `node scripts/seed-event.mjs`.

# Optional: absolute site URL for NFT metadata images
NEXT_PUBLIC_SITE_URL=

# Wallets that can open the check-in screen from the Event tab, comma-separated
EVENT_HOSTS=

# Explore tab: Socemon's own Firebase project (Firestore only, rules can deny all). Server only; Project settings > Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=